{
  "name": "agent-wechat-bridge",
  "version": "0.4.0",
  "description": "WeChat (iLink bot) bridge for coding agents: OpenCode plugin, Codex hooks and a standalone daemon. Push replies, approve and reply from WeChat.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "codex-cli",
    "wechat",
    "weixin",
    "ai-agent",
    "ai-coding",
    "notifications"
  ],
  "license": "MIT",
  "author": "xixi25937",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xixi25937/agent-wechat-bridge.git"
  },
  "homepage": "https://github.com/xixi25937/agent-wechat-bridge#readme",
  "bugs": {
    "url": "https://github.com/xixi25937/agent-wechat-bridge/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "agent-wechat-bridge": "setup.js"
  },
  "files": [
    "index.js",
    "codex.js",
    "codex-question.js",
    "codex-hook.js",
    "files.js",
    "form.js",
    "md.js",
    "quota.js",
    "poll-lock.js",
    "setup.js",
    "daemon.js"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "test": "node --test",
    "send-test": "node -e \"import('./index.js').then(m => m.send(process.argv[1] || 'agent-wechat-bridge 测试')).then(console.log)\""
  }
}
